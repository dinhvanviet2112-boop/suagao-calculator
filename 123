<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Máy Tính Sữa Gạo</title>

<style>
:root{
    --primary:#4CAF50;
    --danger:#ef4444;
    --bg:#f4f6f9;
    --card:#ffffff;
    --text:#1e293b;
    --sub:#64748b;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Segoe UI, Arial, sans-serif;
    background:linear-gradient(135deg,#f8fafc,#e2e8f0);
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:20px;
}

.container{
    width:100%;
    max-width:600px;
}

.card{
    background:var(--card);
    border-radius:24px;
    padding:30px;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
}

h1{
    text-align:center;
    color:var(--text);
    margin-bottom:10px;
}

.subtitle{
    text-align:center;
    color:var(--sub);
    margin-bottom:25px;
}

label{
    display:block;
    margin-bottom:8px;
    font-weight:600;
    color:var(--text);
}

input{
    width:100%;
    padding:15px;
    border:1px solid #cbd5e1;
    border-radius:12px;
    font-size:18px;
    margin-bottom:20px;
}

.results{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.result{
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:#f8fafc;
    padding:15px;
    border-radius:12px;
}

.result span:first-child{
    color:var(--sub);
}

.result strong{
    color:var(--text);
}

.buttons{
    margin-top:20px;
    display:flex;
    gap:10px;
}

button{
    flex:1;
    border:none;
    padding:14px;
    border-radius:12px;
    cursor:pointer;
    font-size:15px;
    font-weight:600;
}

.btn-clear{
    background:var(--danger);
    color:white;
}

.btn-copy{
    background:var(--primary);
    color:white;
}

.note{
    margin-top:25px;
    text-align:center;
    color:var(--sub);
    font-size:14px;
    line-height:1.6;
}

.footer{
    margin-top:15px;
    text-align:center;
    color:#94a3b8;
    font-size:12px;
}
</style>
</head>

<body>

<div class="container">

    <div class="card">

        <h1>🥛 Máy Tính Sữa Gạo</h1>

        <div class="subtitle">
            Nhập số lít sữa thành phẩm mong muốn
        </div>

        <label>Số lít sữa</label>

        <input
            type="number"
            id="litSua"
            step="0.1"
            min="0"
            placeholder="Ví dụ: 2.5">

        <div class="results">

            <div class="result">
                <span>🌾 Gạo tẻ</span>
                <strong id="gaoTe">0 g</strong>
            </div>

            <div class="result">
                <span>🌾 Gạo nếp</span>
                <strong id="gaoNep">0 g</strong>
            </div>

            <div class="result">
                <span>💧 Nước</span>
                <strong id="nuoc">0 ml</strong>
            </div>

            <div class="result">
                <span>🥛 Sữa</span>
                <strong id="sua">0 ml</strong>
            </div>

        </div>

        <div class="buttons">
            <button class="btn-copy" onclick="copyRecipe()">
                📋 Sao chép công thức
            </button>

            <button class="btn-clear" onclick="resetCalculator()">
                ❌ Xóa
            </button>
        </div>

        <div class="note">
            Công thức chuẩn cho 1 lít thành phẩm:<br>
            30g gạo tẻ + 30g gạo nếp + 700ml nước + 440ml sữa
        </div>

        <div class="footer">
            Rice Milk Calculator
        </div>

    </div>

</div>

<script>

const input = document.getElementById("litSua");

input.addEventListener("input", calculate);

function calculate() {

    const lit = parseFloat(input.value) || 0;

    const gaoTe = lit * 30;
    const gaoNep = lit * 30;
    const nuoc = lit * 700;
    const sua = lit * 440;

    document.getElementById("gaoTe").textContent =
        gaoTe.toFixed(1) + " g";

    document.getElementById("gaoNep").textContent =
        gaoNep.toFixed(1) + " g";

    document.getElementById("nuoc").textContent =
        Math.round(nuoc) + " ml";

    document.getElementById("sua").textContent =
        Math.round(sua) + " ml";
}

function resetCalculator() {
    input.value = "";
    calculate();
}

function copyRecipe() {

    const text =
`Sữa thành phẩm: ${input.value || 0} lít

Gạo tẻ: ${document.getElementById("gaoTe").textContent}
Gạo nếp: ${document.getElementById("gaoNep").textContent}
Nước: ${document.getElementById("nuoc").textContent}
Sữa: ${document.getElementById("sua").textContent}`;

    navigator.clipboard.writeText(text);

    alert("Đã sao chép công thức!");
}

</script>

</body>
</html>
